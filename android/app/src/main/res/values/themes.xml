<resources>
    <!-- Base application theme -->
    <style name="Theme.AetherGlass" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <!-- Status bar -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Background -->
        <item name="android:windowBackground">@color/obsidian</item>
        <item name="android:colorBackground">@color/obsidian</item>
    </style>

    <!-- Splash screen theme -->
    <style name="Theme.AetherGlass.Splash" parent="Theme.AetherGlass">
        <item name="android:windowBackground">@drawable/splash_background</item>
    </style>
</resources>